#include<stdlib.h>
#include <stdio.h>
struct node
{
  int data;
    struct node *next;
    struct node* prev;
};
struct node * createnode(int val)
{
    struct node * new_Node=(struct node*)malloc(sizeof(struct node));
    new_Node->data=val;
    new_Node->next=NULL;
    new_Node->prev=NULL;
    return new_Node;
}
int insertRear(struct node **head,struct node ** tail,int val)
{
    struct node *a=createnode(val);
    if(*head==NULL)
    {
        
        *tail= *head=a;
        return 0;
    }
    (*tail)->next=a;
    a->prev=(*tail);
    (*tail)=a;
    return 0;
}
int deleteFront(struct node **head,struct node** tail)
{
     if(*head==NULL)
     {
         printf("List is empty\n");
         return 0;
     }
    struct node *temp=*head;
    if((*head)==(*tail))
    {
        *head=NULL;
        *tail=NULL;
    }
    (*head)->next->prev=NULL;
    *head=(*head)->next;
    free(temp);
}
